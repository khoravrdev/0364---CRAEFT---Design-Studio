        <engine:VisualElement name="menuBar" class="menustyle MenuOptionsFont shootout" style="background-color: rgb(255, 255, 255);">
            <engine:Button text="Home" name="Menu_HomeButton" style="background-color: rgba(0, 0, 0, 0);" />
            <engine:Button text="Visualization &#10;Toolbox" name="VisualizationToolboxButton" />
            <engine:Button text="Interactive &#10;Simulations" name="SimulationsButton" />
            <engine:Button text="Exit" name="Menu_ExitButton" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
