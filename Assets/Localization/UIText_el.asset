  - m_Id: 26399592460288
    m_Localized: "\u039F\u03B4\u03B7\u03B3\u03CC\u03C2 \u03B1\u03C0\u03B5\u03B9\u03BA\u03BF\u03BD\u03B9\u03C3\u03C4\u03AE"
    m_Metadata:
      m_Items: []
  - m_Id: 30478523740160
    m_Localized: "\u0395\u03C1\u03B3\u03B1\u03BB\u03B5\u03B9\u03BF\u03B8\u03AE\u03BA\u03B7
      \u03BF\u03C0\u03C4\u03B9\u03BA\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 34554607087616
    m_Localized: "\u03A6\u03C9\u03C4\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03CC
      \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03B5\u03C1\u03BF"
    m_Metadata:
      m_Items: []
  - m_Id: 291907730452480
    m_Localized: "<b>\u039F\u03B4\u03B7\u03B3\u03AF\u03B5\u03C2 \u03C7\u03C1\u03AE\u03C3\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE\u03C2 Design
      Studio</b>\n\n<b>1. \u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03BC\u03AD\u03B8\u03BF\u03B4\u03BF
      \u03B1\u03C0\u03B5\u03B9\u03BA\u03CC\u03BD\u03B9\u03C3\u03B7\u03C2</b> \u038C\u03C4\u03B1\u03BD
      \u03BE\u03B5\u03BA\u03B9\u03BD\u03AC \u03B7 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE,
      \u03B8\u03B1 \u03B4\u03B5\u03AF\u03C4\u03B5 \u03B4\u03CD\u03BF \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2:\n<b>CPU
      Renderer</b>: \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 Scalar_RGB
      (\u03A0\u03B9\u03BF \u03B1\u03C1\u03B3\u03CC, \u03C3\u03C5\u03BC\u03B2\u03B1\u03C4\u03CC
      \u03BC\u03B5 \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      PC).\n<b>GPU Renderer</b>: \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 Cuda_RGB
      (\u03A0\u03B9\u03BF \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03BF, \u03BC\u03CC\u03BD\u03BF
      \u03B3\u03B9\u03B1 NVIDIA).\n\n<b>2. \u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5
      \u03C4\u03CD\u03C0\u03BF \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2</b>
      \n\u039C\u03B5\u03C4\u03AC \u03C4\u03B9\u03C2 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2
      \u03B1\u03C0\u03B5\u03B9\u03BA\u03CC\u03BD\u03B9\u03C3\u03B7\u03C2, \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5:\n<b>Simple
      Obj</b>: \u0391\u03C0\u03B5\u03B9\u03BA\u03BF\u03BD\u03AF\u03B6\u03B5\u03B9
      \u03AD\u03BD\u03B1 3D \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C5\u03C6\u03AD\u03C2.\n<b>Textured Obj</b>: \u0391\u03C0\u03B5\u03B9\u03BA\u03BF\u03BD\u03AF\u03B6\u03B5\u03B9
      \u03AD\u03BD\u03B1 3D \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF \u03BC\u03B5
      \u03C7\u03AC\u03C1\u03C4\u03B7 \u03C5\u03C6\u03AE\u03C2.\n\n<b>3. \u03A6\u03AC\u03C3\u03B7
      \u03B1\u03C0\u03B5\u03B9\u03BA\u03CC\u03BD\u03B9\u03C3\u03B7\u03C2</b> \n\u039C\u03CC\u03BB\u03B9\u03C2
      \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03C4\u03B5 \u03BC\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE:\n-\u039A\u03AC\u03BD\u03C4\u03B5
      \u03BA\u03BB\u03B9\u03BA \u03C3\u03C4\u03BF <b>\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03B1\u03C1\u03C7\u03B5\u03AF\u03C9\u03BD</b>.\n-\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5
      \u03C4\u03BF \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF input.obj \u03C0\u03BF\u03C5
      \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03C0\u03B5\u03B9\u03BA\u03BF\u03BD\u03AF\u03C3\u03B5\u03C4\u03B5.\n-\u0391\u03BD\u03BF\u03AF\u03BE\u03C4\u03B5
      \u03C4\u03BF \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF.\n-\u039A\u03AC\u03BD\u03C4\u03B5
      \u03BA\u03BB\u03B9\u03BA \u03C3\u03C4\u03BF <b>\u0388\u03BD\u03B1\u03C1\u03BE\u03B7
      \u03B1\u03C0\u03B5\u03B9\u03BA\u03CC\u03BD\u03B9\u03C3\u03B7\u03C2</b>.\n-\u0397
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B5\u03BA\u03C4\u03B5\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03C0\u03B1\u03C1\u03B1\u03C3\u03BA\u03AE\u03BD\u03B9\u03BF
      (\u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C1\u03BA\u03AD\u03C3\u03B5\u03B9
      \u03BC\u03B5\u03C1\u03B9\u03BA\u03AC \u03BB\u03B5\u03C0\u03C4\u03AC).\n-\u03A4\u03B1
      \u03B1\u03C0\u03B5\u03B9\u03BA\u03BF\u03BD\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1
      PNG \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03B8\u03CC\u03BD\u03B7 \u03CC\u03C4\u03B1\u03BD
      \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03B8\u03B5\u03AF.\n-\u03A4\u03B1
      \u03B1\u03C1\u03C7\u03B5\u03AF\u03B1 \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF pipeline (\u03C0.\u03C7.
      photobooth_cpu) \u03C3\u03C4\u03BF MitsubaFiles.\n\n<b>4. \u03A7\u03C1\u03AE\u03C3\u03B7
      \u03BD\u03AD\u03C9\u03BD \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03C9\u03BD Obj</b>
      \n\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B1 \u03B1\u03C1\u03C7\u03B5\u03AF\u03B1 \u03C3\u03C4\u03B9\u03C2
      \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03B1\u03C0\u03B5\u03B9\u03BA\u03CC\u03BD\u03B9\u03C3\u03B7\u03C2.\n\n\_
      \_ <b>\u0393\u03B9\u03B1 Simple Obj (\u03A7\u03C9\u03C1\u03AF\u03C2 \u03A5\u03C6\u03AE):</b>
      \_\n \_ - \u039C\u03B5\u03C4\u03B1\u03B2\u03B5\u03AF\u03C4\u03B5 \u03C3\u03C4\u03BF
      MitsubaFiles/photobooth_cpu (\u03AE gpu).\n \_ - \u0391\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03BF <i>input.obj</i> \u03BC\u03B5 \u03C4\u03BF \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF
      \u03C3\u03B1\u03C2 (\u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      <i>input.obj</i>).\n\n\_ \_ <b>\u0393\u03B9\u03B1 Textured Obj:</b>\n\_ \_
      - \u039C\u03B5\u03C4\u03B1\u03B2\u03B5\u03AF\u03C4\u03B5 \u03C3\u03C4\u03BF
      MitsubaFiles/photobooth2_cpu (\u03AE gpu). \n\_ \_ - \u0391\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03BF <i>input_with_texture.obj</i> \u03BC\u03B5 \u03C4\u03BF \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF
      \u03C3\u03B1\u03C2. \_\n  \_ - \u0391\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03BF <i>texturemap.jpg</i> \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C5\u03C6\u03AE
      \u03C3\u03B1\u03C2. \n\_ \_ - \u0394\u03B9\u03B1\u03C4\u03B7\u03C1\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B1 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C4\u03C9\u03BD
      \u03B1\u03C1\u03C7\u03B5\u03AF\u03C9\u03BD \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2
      \u03C4\u03B1 \u03AF\u03B4\u03B9\u03B1.\n\n<b>5. \u03A0\u03BF\u03CD \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03B1\u03C0\u03B5\u03B9\u03BA\u03BF\u03BD\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B5\u03B9\u03BA\u03CC\u03BD\u03B5\u03C2;</b>\n-\u03A6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2
      Photobooth \u03B3\u03B9\u03B1 \u03B1\u03C0\u03BB\u03CC \u03C0\u03BB\u03AD\u03B3\u03BC\u03B1.\n-\u03A6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2
      Photobooth2 \u03B3\u03B9\u03B1 \u03C5\u03C6\u03AE.\n-\u039F\u03BD\u03BF\u03BC\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      output_000.png ... output_N.png.\n\n<i>\u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03CC\u03BD\u03BF \u03B1\u03C1\u03C7\u03B5\u03AF\u03B1 .obj.</i>\""
