      \u03C0\u03C1\u03BF\u03C3\u03B8\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD, \u03B1\u03C6\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD,
      \u03B1\u03BB\u03BB\u03B7\u03BB\u03BF\u03C3\u03C5\u03BD\u03B4\u03B5\u03CC\u03BC\u03B5\u03BD\u03C9\u03BD
