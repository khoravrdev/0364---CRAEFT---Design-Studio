  m_TableData:
  - m_Id: 65851928576
    m_Localized: Studio de design
    m_Metadata:
      m_Items: []
  - m_Id: 65935814656
    m_Localized: Simulations interactives
    m_Metadata:
      m_Items: []
  - m_Id: 65940008960
    m_Localized: "Des simulateurs permettant de mettre en \u0153uvre des actions
      additives, soustractives, imbriqu\xE9es et de mise en forme, et sp\xE9cialis\xE9s
      pour chaque action artisanale sp\xE9cifique."
    m_Metadata:
      m_Items: []
  - m_Id: 65940008961
    m_Localized: "Bo\xEEte \xE0 outils de visualisation"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203264
    m_Localized: "Pour simplifier la cr\xE9ation de mod\xE8les d'artefacts et pr\xE9dire
      l'apparence des produits qui mettent en \u0153uvre ces mod\xE8les."
    m_Metadata:
      m_Items: []
  - m_Id: 65944203265
    m_Localized: "Moul\xE9 et coul\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203266
    m_Localized: "Visualisez le moule en 3D pour les mod\xE8les"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203267
    m_Localized: cabine photo
    m_Metadata:
      m_Items: []
  - m_Id: 65944203268
    m_Localized: "Rendu d'images \xE0 partir de fichiers obj"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203269
    m_Localized: Lampes Tiffany
    m_Metadata:
      m_Items: []
  - m_Id: 65944203270
    m_Localized: "D\xE9couvrez en avant-premi\xE8re l'ambiance que cr\xE9e une lampe
      Tiffany \xE0 partir d'un design"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203271
    m_Localized: "Fen\xEAtres color\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203272
    m_Localized: "Effectue la quantification des couleurs en fonction du nombre de
      couleurs d\xE9termin\xE9 par l'utilisateur \xE0 partir d'une image."
    m_Metadata:
      m_Items: []
  - m_Id: 65944203273
    m_Localized: Sculpture
    m_Metadata:
      m_Items: []
  - m_Id: 65944203274
    m_Localized: "Visualisez des sculptures compos\xE9es de plusieurs pi\xE8ces que
      l'utilisateur peut assembler."
    m_Metadata:
      m_Items: []
  - m_Id: 65944203275
    m_Localized: Travail du canne
    m_Metadata:
      m_Items: []
  - m_Id: 65944203276
    m_Localized: Visualisez l'apparence des compositions en canne.
    m_Metadata:
      m_Items: []
  - m_Id: 65944203277
    m_Localized: "Gravure sur m\xE9tal"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203278
    m_Localized: "Visualisez l'apparence de pi\xE8ces m\xE9talliques grav\xE9es en
      convertissant les motifs de gravure en mod\xE8les 3D d'objets sculpt\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 65944203279
    m_Localized: "C\xE9ramiques et \xE9maux"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203280
    m_Localized: "Visualisez le vitrage sur n'importe quel mod\xE8le 3D donn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203281
    m_Localized: Simulations interactives
    m_Metadata:
      m_Items: []
  - m_Id: 65944203282
    m_Localized: "Tournage du pl\xE2tre"
    m_Metadata:
      m_Items: []
  - m_Id: 65944203283
    m_Localized: "Simulation du fa\xE7onnage de l'argile au tour de potier"
